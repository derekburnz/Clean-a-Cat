{
  "name": "CleanACat",
  "globIgnorePaths": ["**/README.md", "**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": { "optional": "Packages" } },
      "Assets": { "$path": { "optional": "../../assets/clean-a-cat/rbx" } }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "ServerPackages": { "$path": { "optional": "ServerPackages" } }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "PH_Floor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [128, 1, 128],
          "Position": [0, -0.5, 0],
          "Color": [0.639, 0.635, 0.647],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "PH_Spawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [6, 1, 6],
          "Position": [0, 0.5, 0],
          "Transparency": 1,
          "CanCollide": false,
          "Neutral": true,
          "Duration": 0
        }
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": { "RespectFilteringEnabled": true }
    },

    "TextChatService": {
      "$className": "TextChatService",
      "$properties": { "ChatVersion": "TextChatService" }
    }
  }
}
