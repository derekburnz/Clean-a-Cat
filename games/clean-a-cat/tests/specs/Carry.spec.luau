--!strict
return function()
	local Effects = game:GetService("StarterPlayer")
		:WaitForChild("StarterPlayerScripts")
		:WaitForChild("Client")
		:WaitForChild("Effects")
	local Carry = require(Effects:WaitForChild("Carry")) :: any
	local WashCamera = require(Effects:WaitForChild("WashCamera")) :: any

	local function near(a: number, b: number): boolean
		return math.abs(a - b) < 1e-6
	end

	describe("carry", function()
		it("keeps the library's folded-arms pose", function()
			local p = Carry.pose(Carry.CROSSED.arms)
			expect(p.shL).to.equal(25)
			expect(p.elR).to.equal(35)
			expect(p.neck).to.equal(-12)
			expect(Carry.pose({}).shL).to.equal(0)
		end)
		it("uses Derek's hold behind its switch and always in Studio", function()
			expect(Carry.chooseHold(false, false)).to.equal(Carry.CROSSED)
			expect(Carry.chooseHold(true, false)).to.equal(Carry.POSE)
			expect(Carry.chooseHold(false, true)).to.equal(Carry.POSE)
			-- Derek's Catch a Cat Cafe arms (his reference, 2026-11-24): on R6 raised forward 65 and swung 35 in, so
			-- they reach out at chest height and meet under the cat; head tipped down to him
			local r6 = Carry.pose(Carry.POSE.arms6)
			expect(r6.shL).to.equal(65)
			expect(r6.spL).to.equal(-35)
			expect(r6.neck < 0).to.equal(true)
			local p = Carry.pose(Carry.POSE.arms)
			expect(p.spL < 0 and p.spR < 0).to.equal(true)
		end)
		it("lays the loaf across the arms, against the chest, head end up", function()
			local p = Carry.POSE
			expect(p.loafTurn).to.equal(90)
			expect(p.hug).to.equal(true)
			expect(Carry.CROSSED.hug).to.equal(false)
			expect(p.loafRoll > 0 and p.loafRoll <= 15).to.equal(true)
			-- #353's head tipped onto his paws stands taller, so the loaf sits lower than a sit to keep it under the chin
			expect(p.loafGap < p.gap and p.loafGap >= 0).to.equal(true)
			-- R6's block arms: he sits higher on them, below his chin's room (0.8 clear at gap 0)
			expect(p.loafGap6 > p.loafGap and p.loafGap6 < 0.8).to.equal(true)
			expect(Carry.CROSSED.loafGap6).to.equal(Carry.CROSSED.loafGap)
			-- R6's loaf sits a little out from the chest, off the climbing arms, but still on them
			expect(p.loafOut6 > 0 and p.loafOut6 <= 0.5).to.equal(true)
			expect(Carry.CROSSED.loafOut6).to.equal(0)
			-- his width faces the chest, not his length: the muddy loaf is 1.38 wide and 1.87 long
			local size = Vector3.new(1.38, 1.59, 1.87)
			expect(near(Carry.reach(1, size, true), 0.5 + 0.69 + 0.05)).to.equal(true)
			expect(near(Carry.reach(1, size, false), 0.5 + 0.935 + 0.05)).to.equal(true)
		end)
		it("eases back to his own size over the hop, landing at it", function()
			expect(Carry.hopScale(1.4, 1, 0)).to.equal(1.4)
			expect(near(Carry.hopScale(1.4, 1, 0.5), 1.2)).to.equal(true)
			expect(Carry.hopScale(1.4, 1, 1)).to.equal(1)
			-- placeIn's endScale: he lands at the tub body's 1.5, so the sit body takes over with no pop (Sync-Agent)
			expect(Carry.hopScale(1.4, 1.5, 1)).to.equal(1.5)
			expect(Carry.hopScale(1, 1, 0.3)).to.equal(1)
		end)
		it("reaches down before the lift only when asked", function()
			expect(near(Carry.settleSeconds(false), Carry.FOLD_SECONDS)).to.equal(true)
			expect(near(Carry.settleSeconds(nil), Carry.FOLD_SECONDS)).to.equal(true)
			local lead = Carry.REACH.seconds + Carry.REACH.grab
			expect(near(Carry.settleSeconds(true), lead + Carry.FOLD_SECONDS)).to.equal(true)
			expect(lead <= 0.5).to.equal(true)
			-- bending down and forward: arms reach forward, head looks down, R15 bends at the waist
			expect(Carry.REACH.arms6.shL > 0 and Carry.REACH.arms6.neck < 0).to.equal(true)
			expect(Carry.REACH.arms.waist > 0).to.equal(true)
		end)
		it("folds in FOLD_SECONDS and opens in OPEN_SECONDS", function()
			expect(near(Carry.weight(0, true, Carry.FOLD_SECONDS), 1)).to.equal(true)
			expect(Carry.weight(0, true, Carry.FOLD_SECONDS / 2) < 1).to.equal(true)
			expect(near(Carry.weight(1, false, Carry.OPEN_SECONDS), 0)).to.equal(true)
			expect(Carry.weight(1, true, 5)).to.equal(1)
			expect(Carry.weight(0, false, 5)).to.equal(0)
			expect(Carry.FOLD_SECONDS <= 0.35).to.equal(true)
		end)
		it("lifts and hops in an arc, with no arc under Reduced Motion", function()
			local a0, h0 = Carry.lift(0, false)
			local a1, h1 = Carry.lift(Carry.FOLD_SECONDS, false)
			expect(a0).to.equal(0)
			expect(h0).to.equal(0)
			expect(near(a1, 1) and near(h1, 0)).to.equal(true)
			local _, mid = Carry.lift(Carry.FOLD_SECONDS / 2, false)
			local _, calm = Carry.lift(Carry.FOLD_SECONDS / 2, true)
			expect(near(mid, Carry.LIFT_ARC)).to.equal(true)
			expect(calm).to.equal(0)
			local _, hopMid = Carry.hop(Carry.HOP_SECONDS / 2, false)
			local _, hopCalm = Carry.hop(Carry.HOP_SECONDS / 2, true)
			expect(near(hopMid, Carry.HOP_HEIGHT)).to.equal(true)
			expect(hopCalm).to.equal(0)
			local done = Carry.hop(Carry.HOP_SECONDS * 2, false)
			expect(done).to.equal(1)
		end)
	end)

	describe("wash camera", function()
		it("eases over about 0.6 s and cuts under Reduced Motion", function()
			expect(near(WashCamera.SECONDS, 0.6)).to.equal(true)
			expect(WashCamera.progress(0, false)).to.equal(0)
			expect(near(WashCamera.progress(WashCamera.SECONDS / 2, false), 0.5)).to.equal(true)
			expect(near(WashCamera.progress(WashCamera.SECONDS, false), 1)).to.equal(true)
			expect(WashCamera.progress(0, true)).to.equal(1)
		end)
		it("never overshoots", function()
			for i = 0, 20 do
				local k = WashCamera.ease(i / 20)
				expect(k >= 0 and k <= 1).to.equal(true)
			end
			expect(WashCamera.ease(2)).to.equal(1)
		end)
		it("moves on to another shot from where the camera is, but never while leaving", function()
			-- stand-ins for camera CFrames: retarget only passes them through (the test runner has no CFrame)
			local tub, station, current, home = {} :: any, {} :: any, {} :: any, {} :: any
			local entering = { from = home, to = tub, start = 0, leaving = false }
			local moved = WashCamera.retarget(entering, current, station, 3)
			expect(moved ~= nil).to.equal(true)
			expect(moved.from).to.equal(current)
			expect(moved.to).to.equal(station)
			expect(moved.start).to.equal(3)
			expect(moved.leaving).to.equal(false)
			local leaving = { from = tub, to = home, start = 0, leaving = true }
			expect(WashCamera.retarget(leaving, current, station, 3)).to.equal(nil)
		end)
	end)
end
