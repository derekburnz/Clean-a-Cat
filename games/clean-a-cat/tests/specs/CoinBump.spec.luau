--!strict
return function()
	local Client =
		game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client")
	local CoinBump = require(Client:WaitForChild("Effects"):WaitForChild("CoinBump")) :: any

	describe("CoinBump.gain", function()
		it("does nothing for the first value or a drop", function()
			local s = CoinBump.new()
			expect(CoinBump.gain(s, 0, 100, false)).to.equal(false)
			expect(CoinBump.shown(s, 0)).to.equal(100)
			expect(CoinBump.gain(s, 1, 40, false)).to.equal(false)
			expect(CoinBump.shown(s, 1)).to.equal(40)
			expect(CoinBump.busy(s, 1)).to.equal(false)
		end)
		it("bumps and counts up on a gain", function()
			local s = CoinBump.new()
			CoinBump.gain(s, 0, 100, false)
			expect(CoinBump.gain(s, 10, 200, false)).to.equal(true)
			expect(CoinBump.shown(s, 10)).to.equal(100)
			local mid = CoinBump.shown(s, 10 + CoinBump.COUNT / 2)
			expect(mid > 100 and mid < 200).to.equal(true)
			expect(CoinBump.shown(s, 10 + CoinBump.COUNT)).to.equal(200)
			expect(CoinBump.busy(s, 10 + CoinBump.COUNT)).to.equal(false)
		end)
		it("continues from the number shown and never bumps twice in 0.5 s", function()
			local s = CoinBump.new()
			CoinBump.gain(s, 0, 0, false)
			CoinBump.gain(s, 10, 100, false)
			local at = CoinBump.shown(s, 10.2)
			expect(CoinBump.gain(s, 10.2, 150, false)).to.equal(false)
			expect(CoinBump.shown(s, 10.2)).to.equal(at)
			expect(CoinBump.shown(s, 10.2 + CoinBump.COUNT)).to.equal(150)
			expect(CoinBump.gain(s, 11, 160, false)).to.equal(true)
		end)
		it("shows the number at once when still (Reduced Motion or switch off)", function()
			local s = CoinBump.new()
			CoinBump.gain(s, 0, 10, false)
			expect(CoinBump.gain(s, 5, 90, true)).to.equal(false)
			expect(CoinBump.shown(s, 5)).to.equal(90)
		end)
	end)

	describe("CoinBump.scale", function()
		it("goes from 1 to the peak and back within 0.2 s, never past the peak", function()
			local s = CoinBump.new()
			CoinBump.gain(s, 0, 0, false)
			CoinBump.gain(s, 1, 5, false)
			expect(CoinBump.scale(s, 1)).to.equal(1)
			local top = 0
			for i = 0, 40 do
				top = math.max(top, CoinBump.scale(s, 1 + i * 0.005))
			end
			expect(top <= CoinBump.PEAK + 1e-6 and top > 1.1).to.equal(true)
			expect(CoinBump.scale(s, 1.2)).to.equal(1)
		end)
	end)

	describe("CoinBump.wantsSound", function()
		it("keeps 2 s between sounds and skips helper pay", function()
			local s = CoinBump.new()
			expect(CoinBump.wantsSound(s, 10, -math.huge)).to.equal(true)
			expect(CoinBump.wantsSound(s, 11, -math.huge)).to.equal(false)
			expect(CoinBump.wantsSound(s, 12.5, 12.55)).to.equal(false)
			expect(CoinBump.wantsSound(s, 13, -math.huge)).to.equal(true)
		end)
	end)
end
