local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LikeHowToRules =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("LikeHowToRules"))

return function()
	describe("LikeHowToRules.frame", function()
		it("brings the hand down, taps, fills pink, then resets", function()
			expect(LikeHowToRules.frame(0, false).hand).to.equal(0)
			expect(LikeHowToRules.frame(0, false).filled).to.equal(false)
			local tap = LikeHowToRules.frame(0.75, false)
			expect(tap.press).to.equal(1)
			expect(tap.filled).to.equal(true)
			expect(tap.ring > 0 and tap.ring < 1).to.equal(true)
			expect(LikeHowToRules.frame(1.2, false).filled).to.equal(true)
			expect(LikeHowToRules.frame(2.0, false).hand).to.equal(0) -- the loop starts again
		end)
		it("holds the last frame still with Reduced Motion", function()
			local still = LikeHowToRules.frame(0.1, true)
			expect(still.filled).to.equal(true)
			expect(still.hand).to.equal(1)
			expect(still.ring).to.equal(0)
		end)
	end)
	describe("LikeHowToRules.note", function()
		it("never says the like is checked", function()
			expect(LikeHowToRules.note(false)).to.equal("Your gift comes either way")
			expect(LikeHowToRules.note(true)).to.equal("Your gifts come either way")
			expect(string.find(string.lower(LikeHowToRules.CAPTION), "check")).to.equal(nil)
		end)
	end)
end
